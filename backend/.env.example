[TEMPLATE]
# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cloudops:cloudops@localhost:5434/cloudops_ai

# --- Authentication ---
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
ADMIN_EMAIL=admin@cloudops.local
ADMIN_PASSWORD=ChangeMe123!

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Retries for transient provider failures (rate limits, 5xx, timeouts) ---
# LLM_MAX_RETRIES counts attempts *after* the first one: 2 means up to 3 tries per call.
# Set to 0 to disable retrying entirely.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8.0

# --- Per-attempt timeouts, in seconds (0 disables that bound) ---
# A timed-out attempt is a transient failure, so it is retried under the policy above.
# LLM_REQUEST_TIMEOUT caps one whole chat/embed/health attempt.
# LLM_STREAM_IDLE_TIMEOUT caps the silence *between* streamed chunks, not the total length,
# so a slow but actively producing generation is never cut off.
# LLM_CONNECT_TIMEOUT bounds connection setup in the provider HTTP clients.
LLM_REQUEST_TIMEOUT=30
LLM_STREAM_IDLE_TIMEOUT=60
LLM_CONNECT_TIMEOUT=5

# --- Rate limiting (per user, per route group) ---
LLM_RATE_LIMIT=20
EMBEDDING_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Provider budget (project-wide, shared by every user) ---
# Counts upstream *attempts*, not HTTP requests: one request can embed once per runbook
# chunk, and a replayed retry is another request as far as the provider is concerned.
# Left unset it follows the provider -- 20 for Gemini, matching the free tier's 20
# generateContent requests per day per project per model, and unlimited for Ollama, which
# has no quota to protect. Set 0 to stop counting, or raise it for a billed plan.
# GET /health/llm reports limit/used/remaining/resets_in.
# LLM_QUOTA_LIMIT=20
# LLM_QUOTA_WINDOW_SECONDS=86400

# --- Pagination ---
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=200

# --- Observability ---
LOG_LEVEL=INFO

# --- Optional: Ollama fallback ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
