# --- App ---
# ENVIRONMENT=production turns on the startup guard: a missing or still-default JWT_SECRET,
# ADMIN_PASSWORD or GEMINI_API_KEY then refuses to start (see DEPLOYMENT.md). DEBUG returns
# tracebacks to callers and is refused in production.
ENVIRONMENT=development
DEBUG=false
APP_NAME=Excubitor — CloudOps AI
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- API documentation ---
# FastAPI's /docs, /redoc and /openapi.json. A development aid: the schema maps every route,
# parameter and response shape, which is a map of the whole surface for anyone who asks. Left
# unset it follows the environment -- on outside production, off inside it -- so a deployment
# serves only the API and the dashboard. Set true to publish it from production on purpose, or
# false to keep it off everywhere.
# EXPOSE_API_DOCS=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cloudops:cloudops@localhost:5434/cloudops_ai

# --- Session ---
# JWT_SECRET signs the session cookie: generate one with `python -c "import secrets;
# print(secrets.token_urlsafe(48))"` and never reuse the value in this file.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
COOKIE_NAME=cloudops_session
# COOKIE_SECURE must be true behind HTTPS; false is only for local plain-HTTP stacks.
COOKIE_SECURE=false
ADMIN_EMAIL=admin@cloudops.local
ADMIN_PASSWORD=ChangeMe123!

# --- Alert ingestion (Prometheus Alertmanager) ---
# Shared secret for POST /webhooks/alertmanager, sent by Alertmanager as `X-API-Key`.
# This endpoint has no user behind it, so the token is the whole identity: it is a machine
# caller, not a role. Left empty the route answers 503 rather than accepting anything, so an
# unconfigured deployment is never an open write route. Rotate it like any other credential.
ALERTMANAGER_WEBHOOK_TOKEN=

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Retries for transient provider failures (rate limits, 5xx, timeouts) ---
# LLM_MAX_RETRIES counts attempts *after* the first one: 2 means up to 3 tries per call.
# Set to 0 to disable retrying entirely.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8.0

# --- Per-attempt timeouts, in seconds (0 disables that bound) ---
# A timed-out attempt is a transient failure, so it is retried under the policy above.
# LLM_REQUEST_TIMEOUT caps one whole chat/embed/health attempt.
# LLM_STREAM_IDLE_TIMEOUT caps the silence *between* streamed chunks, not the total length,
# so a slow but actively producing generation is never cut off.
# LLM_CONNECT_TIMEOUT bounds connection setup in the provider HTTP clients.
LLM_REQUEST_TIMEOUT=30
LLM_STREAM_IDLE_TIMEOUT=60
LLM_CONNECT_TIMEOUT=5

# --- The proxy's patience, in seconds ---
# How long the reverse proxy in front of this service will wait for a response, as configured
# THERE (nginx `proxy_read_timeout`, Caddy `read_timeout`). This value is not enforced by the
# app; it is what the app compares itself against, because the slowest answer this service can
# produce is LLM_REQUEST_TIMEOUT x (LLM_MAX_RETRIES + 1) plus backoff -- about 92s with the
# defaults above. A proxy still on nginx's 60s default therefore gives up first, and what the
# caller sees is the proxy's own error rather than the API's sentence and request id. Keep the
# proxy's read timeout for /api/ above this value; DEPLOYMENT.md has working examples.
# GET /health/llm reports both numbers as `timeouts`.
PROXY_READ_TIMEOUT_SECONDS=120

# --- Rate limiting (per user, per route group) ---
LLM_RATE_LIMIT=20
EMBEDDING_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Provider budget (project-wide, shared by every user) ---
# Counts upstream *attempts*, not HTTP requests: one request can embed once per runbook
# chunk, and a replayed retry is another request as far as the provider is concerned.
# Left unset it follows the provider -- 20 for Gemini, matching the free tier's 20
# generateContent requests per day per project per model, and unlimited for Ollama, which
# has no quota to protect. Set 0 to stop counting, or raise it for a billed plan.
# GET /health/llm reports limit/used/remaining/resets_in.
# LLM_QUOTA_LIMIT=20
# LLM_QUOTA_WINDOW_SECONDS=86400

# --- Shared counters (rate limit + provider budget) ---
# Empty keeps the counters in this process, which is correct for one worker and invisible to
# every other one: the real ceiling becomes workers x limit. Set it to Redis whenever more
# than one worker serves traffic. With Redis unreachable the store degrades to per-process
# counters, so a shared ceiling never silently disappears. GET /health reports `counters`
# ("ok", "unconfigured", or why it is unreachable) and the quota block names its store.
# REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=cloudops
# REDIS_TIMEOUT_SECONDS=2

# --- Public demo login (the "try the demo" button) ---
# A shared, read-only account the sign-in page offers to a stranger. Off unless a deployment asks
# for it, and unusable without a password: DEMO_ACCOUNT_PASSWORD is PUBLISHED to anyone who opens
# the sign-in page (GET /auth/demo serves it to the button), so use a value used nowhere else and
# rotate it like the public credential it is. The account is re-asserted as a Viewer on every
# startup, so a promotion made in the UI does not survive a restart, and turning the feature off
# refuses the credential at sign-in rather than only hiding the button.
# DEMO_ACCOUNT_ENABLED=false
# DEMO_ACCOUNT_EMAIL=demo@excubitor.local
# DEMO_ACCOUNT_NAME=Demo Visitor
# DEMO_ACCOUNT_PASSWORD=
# AI calls the shared login may spend per LLM_QUOTA_WINDOW_SECONDS, so one visitor cannot empty
# the project's provider budget (LLM_QUOTA_LIMIT) before the next one arrives. 0 leaves the shared
# login on the ordinary per-user limits.
# DEMO_ACCOUNT_RATE_LIMIT=5

# --- Demo data ---
# Seeds three invented alerts into an empty database. Unset it follows the environment:
# on outside production, off inside it. Set false for a clean start anywhere.
# SEED_DEMO_DATA=true

# --- Pagination ---
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=200

# --- Observability ---
LOG_LEVEL=INFO

# --- Optional: Ollama fallback ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
